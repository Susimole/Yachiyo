{
  "name": "yachiyo",
  "productName": "Yachiyo",
  "version": "0.1.1",
  "description": "一个能陪着你的开源 AI 桌宠 —— 分层立绘 + 网格形变骨架 + 会记事的大脑",
  "license": "MIT",
  "main": "src/main/index.cjs",
  "scripts": {
    "start": "node scripts/start.cjs",
    "serve": "node scripts/serve.cjs",
    "test": "node tests/run.cjs",
    "test:all": "node tests/run.cjs --all",
    "diag": "node scripts/diag-pack.cjs",
    "build": "electron-builder --win nsis",
    "build:dir": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "44.4.4",
    "electron-builder": "^26.15.3"
  },
  "type": "module",
  "build": {
    "appId": "com.yachiyo.pet",
    "productName": "Yachiyo",
    "copyright": "Copyright © 2026 速食面",
    "files": [
      "src/main/**/*",
      "src/core/**/*",
      "src/renderer/**/*",
      "package.json",
      "!**/*.map",
      "!**/node_modules/**/*",
      "!src/renderer/assets/icon-旧-256.ico"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "asar": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-安装包.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Yachiyo",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    }
  },
  "author": {
    "name": "速食面"
  },
  "keywords": [
    "electron",
    "desktop-pet",
    "ai",
    "llm",
    "windows"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Susimole/Yachiyo.git"
  }
}
